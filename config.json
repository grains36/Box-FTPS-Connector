{
  "name": "Box FTPS Import",
  "namespace": "BoxFTPSImport\\BoxFTPSImportModule",
  "authors": [
    {
      "name": "Gary Rains",
      "email": "gary.rains@duke.edu",
      "institution": "Duke University School of Medicine"
    }
  ],
  "description": "Imports files from Box into REDCap",
  "framework-version": 14,
  "crons": [
    {
      "cron_name": "box_import_cron",
      "cron_description": "Cron that runs every hour to execute any import jobs",
      "method": "importmethod",
      "cron_frequency": "3600",
      "cron_max_run_time": "500"
    }
  ],
"no-auth-pages": [
    "boximp_now"
  ],
  "no-csrf-pages": [
     "boximp_now"
      ],
  "links": {
    "control-center": [],
    "project": [
      {
        "name": "BoxImport",
        "icon": "report",
        "url": "boximp_now.php?NOAUTH"
      }
    ]
  },
  "project-settings": [
    {
      "key": "enable_cron",
      "name": "Enable Cron",
      "type": "checkbox",
      "required": false
    },
    {
      "key": "site",
      "name": "Site",
      "type": "text",
      "required": true
    },
    {
      "key": "port",
      "name": "Port",
      "type": "text",
      "required": true
    },
    {
      "key": "username",
      "name": "Username",
      "type": "password",
      "required": true
    },
    {
      "key": "password",
      "name": "Password",
      "type": "password",
      "required": true
    },
     {
	   "key": "api_token",
	   "name": "API Token",
	   "type": "password",
	   "required": true
        },
    {
      "key": "import_jobs",
      "name": "Import Jobs",
      "type": "sub_settings",
      "repeatable": true,
      "sub_settings": [
        {
          "key": "remote_file",
          "name": "Remote File",
          "type": "text",
          "required": false
        },
        {
          "key": "destination_type",
          "name": "Destination Type",
          "type": "dropdown",
          "choices": [
            { "value": "data", "name": "REDCap Data" },
            { "value": "repo", "name": "File Repo" }
          ]
        },
        {
          "key": "repo_folder_id",
          "name": "Repo Folder ID",
          "type": "text",
          "required": false
        },
        {
          "key": "event_id",
          "name": "Event ID",
          "type": "text",
          "required": false
        },
        {
          "key": "field_map",
          "name": "Field Map",
          "type": "text",
          "required": false
        }
      ]
    }
  ]
}